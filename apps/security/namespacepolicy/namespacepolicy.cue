package namespacepolicy

import (
	"encoding/json"

	"github.com/selfuryon/awesome-cue-infra/apps"
	core_v1 "cue.dev/x/k8s.io/api/core/v1"
	cilium_v2 "github.com/selfuryon/awesome-cue-infra/crd/cilium/v2"
)

// Defaults for every namespace, existing and future, generated by Kyverno
// GeneratingPolicies (CEL) and kept in sync:
//
//   *-system namespaces (the platform): CiliumNetworkPolicy `allow-all`
//   every other namespace:              CiliumNetworkPolicy `default-deny`
//                                       (nothing in, only DNS to kube-dns out)
//                                       LimitRange `default-limits`
//
// Applications open what they need with their own policies next to them
// (e.g. apps/examples/whoami). Platform components must therefore live in a
// `*-system` namespace.
//
// Lives in the `policy` set: the CRDs come with Kyverno and Cilium in `system`.

_isSystem: "object.metadata.name.endsWith('-system')"
// Namespaces without workloads that need no defaults.
_isApp: "!object.metadata.name.endsWith('-system') && !(object.metadata.name in ['kube-public', 'kube-node-lease'])"

// A GeneratingPolicy that creates #object in every Namespace matching
// #condition (CEL over the Namespace). #object is typed CUE without a
// namespace (generator.Apply sets it); it reaches CEL as JSON through
// json.unmarshal, which avoids dyn()-wrapping a nested CEL map literal.
#Generate: {
	#condition!: string
	#object!: {
		apiVersion!: string
		kind!:       string
		metadata!: name!: string
		...
	}

	let _json = json.Marshal(#object)

	// The JSON is embedded in a single-quoted CEL string.
	_quoted: _json & !~"'"

	spec: {
		evaluation: {
			synchronize: enabled:      true
			generateExisting: enabled: true
		}
		matchConstraints: resourceRules: [{
			apiGroups:   [""]
			apiVersions: ["v1"]
			operations:  ["CREATE", "UPDATE"]
			resources:   ["namespaces"]
		}]
		matchConditions: [{name: "namespace", expression: #condition}]
		generate:        [{expression: "generator.Apply(object.metadata.name, [json.unmarshal('\(_quoted)')])"}]
	}
}

// Type-checks a CiliumNetworkPolicy spec against the schema. `spec` is optional
// in the schema, so it cannot be selected from the definition directly; the
// placeholder metadata only satisfies the schema and is not emitted.
_cnpSpec: {
	#spec: _
	out: (cilium_v2.#CiliumNetworkPolicy & {
		metadata: {name: "typecheck", namespace: "typecheck"}
		spec:     #spec
	}).spec
}

#NamespacePolicy: {
	#cluster: apps.#Cluster

	component: apps.#Component & {
		name:      "namespace-policy"
		namespace: "kyverno-system"
		set:       "policy"

		manifests: global: generatingPolicy: {
			"namespace-allow-all": spec: (#Generate & {
				#condition: _isSystem
				#object: {
					apiVersion: "cilium.io/v2"
					kind:       "CiliumNetworkPolicy"
					metadata: name: "allow-all"
					spec: (_cnpSpec & {
						#spec: {
							description:      "Platform namespace: everything allowed (namespace-allow-all)."
							endpointSelector: {}
							ingress:          [{fromEntities: ["all"]}]
							egress:           [{toEntities: ["all"]}]
						}
					}).out
				}
			}).spec

			"namespace-default-deny": spec: (#Generate & {
				#condition: _isApp
				#object: {
					apiVersion: "cilium.io/v2"
					kind:       "CiliumNetworkPolicy"
					metadata: name: "default-deny"
					spec: (_cnpSpec & {
						#spec: {
							description:      "Default deny (namespace-default-deny): no ingress, egress only DNS to kube-dns. Allow traffic with policies next to the workload."
							endpointSelector: {}
							ingress:          [{}]
							egress: [{
								toEndpoints: [{
									matchLabels: {
										"k8s:io.kubernetes.pod.namespace": "kube-system"
										"k8s:k8s-app":                     "kube-dns"
									}
								}]
								toPorts: [{
									ports: [
										{port: "53", protocol: "UDP"},
										{port: "53", protocol: "TCP"},
									]
								}]
							}]
						}
					}).out
				}
			}).spec

			// Requests/limits for containers that declare none, so one
			// workload cannot take the node's memory.
			"namespace-default-limits": spec: (#Generate & {
				#condition: _isApp
				#object: {
					apiVersion: "v1"
					kind:       "LimitRange"
					metadata: name: "default-limits"
					spec: core_v1.#LimitRangeSpec & {
						limits: [{
							type:           "Container"
							defaultRequest: {cpu: "10m", memory: "32Mi"}
							default: memory: "256Mi"
						}]
					}
				}
			}).spec
		}
	}
}
