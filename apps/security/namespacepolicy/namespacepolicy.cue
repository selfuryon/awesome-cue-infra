package namespacepolicy

import "github.com/selfuryon/awesome-cue-infra/apps"

// Network defaults per namespace, generated by Kyverno for every namespace,
// existing and future, and kept in sync (synchronize):
//
//   *-system namespaces (the platform): CiliumNetworkPolicy `allow-all`
//   every other namespace:              CiliumNetworkPolicy `default-deny`
//                                       (nothing in, only DNS to kube-dns out)
//
// Applications open what they need with their own policies next to them
// (e.g. apps/examples/whoami). Platform components must therefore live in a
// `*-system` namespace.
//
// Lives in the `policy` set: the CRDs come with Kyverno and Cilium in `system`.
#NamespacePolicy: {
	#cluster: apps.#Cluster

	let _generate = {
		#name:            string
		#spec:            {...}
		generateExisting: true
		synchronize:      true
		apiVersion:       "cilium.io/v2"
		kind:             "CiliumNetworkPolicy"
		name:             #name
		namespace:        "{{request.object.metadata.name}}"
		data: spec: #spec
	}

	component: apps.#Component & {
		name:      "namespace-policy"
		namespace: "kyverno-system"
		set:       "policy"

		manifests: global: clusterPolicy: "namespace-network-policy": spec: {
			background: true
			rules: [{
				name: "system-allow-all"
				match: any: [{resources: {kinds: ["Namespace"], names: ["*-system"]}}]
				generate: _generate & {
					#name: "allow-all"
					#spec: {
						description:      "Platform namespace: everything allowed (namespace-network-policy)."
						endpointSelector: {}
						ingress:          [{fromEntities: ["all"]}]
						egress:           [{toEntities: ["all"]}]
					}
				}
			}, {
				name: "default-deny"
				match: any:   [{resources: kinds: ["Namespace"]}]
				exclude: any: [{resources: names: ["*-system", "kube-public", "kube-node-lease"]}]
				generate: _generate & {
					#name: "default-deny"
					#spec: {
						description:      "Default deny (namespace-network-policy): no ingress, egress only DNS to kube-dns. Allow traffic with policies next to the workload."
						endpointSelector: {}
						ingress:          [{}]
						egress: [{
							toEndpoints: [{
								matchLabels: {
									"k8s:io.kubernetes.pod.namespace": "kube-system"
									"k8s:k8s-app":                     "kube-dns"
								}
							}]
							toPorts: [{
								ports: [
									{port: "53", protocol: "UDP"},
									{port: "53", protocol: "TCP"},
								]
							}]
						}]
					}
				}
			}]
		}
	}
}
