package infra

import (
	"encoding/json"
	"encoding/yaml"
	"list"
	"strings"
	"tool/cli"
	"tool/file"

	"github.com/selfuryon/awesome-cue-infra/apps/registry"
	"github.com/selfuryon/awesome-cue-infra/clusters"
)

cluster: *null | string @tag(cluster)
project: *null | string @tag(project)

// Flattens a #Manifests value into its objects, each already marshalled to
// YAML; join them with "---\n" for a stream.
//
// Marshalling each object, rather than collecting the objects into a list for
// yaml.MarshalStream, avoids a full copy of every manifest: the body of a list
// comprehension is a struct literal and CUE never structure-shares one, so
// `[for o in objects {o}]` evaluates each object a second time (seen in
// etherno-infra: `cue cmd dump` cost twice a `cue export` of the same tree).
// Only the key order within maps differs from MarshalStream. Go back to
// yaml.MarshalStream over the objects once CUE shares values a list
// comprehension yields.
#Objects: {
	#m: _
	out: list.Concat([[
		for objects in #m.global
		for object in objects {yaml.Marshal(object)},
	], [
		for scope in #m.scoped
		for objects in scope
		for object in objects {yaml.Marshal(object)},
	]])
}

_clusters: *[for name, _ in clusters.Clusters {name}] | [...string]
if cluster != null {
	_clusters: [cluster]
}

_projects: [
	for c in _clusters
	for p, _ in clusters.Clusters[c].manifests
	if project == null || project == p {
		"cluster": c
		"project": p
	},
]

// Projects published as OCI artifacts (one per set).
_artifacts: [
	for c in _clusters
	if clusters.Clusters[c].config.publish
	for p, _ in clusters.Clusters[c].config.sets {
		"cluster": c
		"project": p
	},
]

_objects: list.Concat([
	for e in _projects {
		(#Objects & {#m: clusters.Clusters[e.cluster].manifests[e.project]}).out
	},
])

_header: "# Code generated by `cue cmd write-release`. DO NOT EDIT.\n"

// cue cmd dump [-t cluster=<name>] [-t project=<bootstrap|flux|argo>]
command: dump: print: cli.Print & {
	text: strings.Join(_objects, "---\n")
}

// cue cmd list-clusters
command: "list-clusters": print: cli.Print & {
	text: json.Marshal(_clusters)
}

// cue cmd list-projects: every rendered project (for diffs).
command: "list-projects": print: cli.Print & {
	text: json.Marshal(_projects)
}

// cue cmd list-artifacts: projects published to the registry.
command: "list-artifacts": print: cli.Print & {
	text: json.Marshal(_artifacts)
}

// cue cmd versions -t cluster=<name>: resolved component versions (for Promote).
command: versions: print: cli.Print & {
	text: json.Marshal({for c in _clusters {(c): clusters.Clusters[c].versions}})
}

// cue cmd cluster-config -t cluster=<name>
command: "cluster-config": print: cli.Print & {
	text: json.Marshal({for c in _clusters {(c): clusters.Clusters[c].config}})
}

// cue cmd write-release: regenerates clusters/<name>/release/<flux|argo>.
command: "write-release": {
	for c in _clusters
	for kind, m in clusters.Clusters[c].release {
		let _dir = "clusters/\(c)/release/\(kind)"
		"mkdir-\(c)-\(kind)": file.MkdirAll & {path: _dir}
		"write-\(c)-\(kind)": file.Create & {
			$after:   command["write-release"]["mkdir-\(c)-\(kind)"]
			filename: "\(_dir)/manifests.yaml"
			contents: _header + strings.Join((#Objects & {#m: m}).out, "---\n")
		}
	}
}

// cue cmd promote -t to=<cluster> [-t from=<latest|cluster>] [-t components=a,b]
//
// Copies component versions into clusters/<to>/pins.json, from latest.json or
// from the versions another cluster currently resolves. Without `components`
// it touches every component the target resolves; an explicit list may also
// add pins the target does not have yet (e.g. a new component on stable).
to:         *null | string     @tag(to)
from:       *"latest" | string @tag(from)
components: *"" | string       @tag(components)

_promote: {
	_source: registry.#Versions
	if from == "latest" {
		_source: registry.latest
	}
	if from != "latest" {
		_source: clusters.Clusters[from].versions
	}

	_target:  clusters.Clusters[to]
	_current: _target.#pins
	_only:    [for s in strings.Split(components, ",") if s != "" {s}]
	_names: [
		if len(_only) > 0 for n in _only {n},
		if len(_only) == 0 for n, _ in _target.versions {n},
	]

	updates: {
		for n in _names if _source[n] != _|_ {
			if _current[n] == _|_ {(n): _source[n]}
			if _current[n] != _|_ if _current[n] != _source[n] {(n): _source[n]}
		}
	}
	// Ordered (name, version) pairs: existing pins keep their place, new ones
	// are appended. Rendered by hand because struct field order is not stable.
	_pairs: [
		for n, v in _current {
			if updates[n] != _|_ {[n, updates[n]]}
			if updates[n] == _|_ {[n, v]}
		},
		for n, v in updates if _current[n] == _|_ {[n, v]},
	]
	contents: "{\n" + strings.Join([for p in _pairs {"  \"\(p[0])\": \"\(p[1])\""}], ",\n") + "\n}\n"
	summary: strings.Join([
		for n, v in updates {
			if _current[n] != _|_ {"\(n): \(_current[n]) -> \(v)"}
			if _current[n] == _|_ {"\(n): (unpinned) -> \(v)"}
		},
	], "\n")
}

command: promote: {
	if to == null {
		usage: cli.Print & {text: "usage: cue cmd promote -t to=<cluster> [-t from=<latest|cluster>] [-t components=a,b]"}
	}
	if to != null {
		write: file.Create & {
			filename: "clusters/\(to)/pins.json"
			contents: _promote.contents
		}
		report: cli.Print & {
			$after: write
			text: [
				if len(_promote.updates) == 0 {"\(to): nothing to promote from \(from)"},
				"\(to) <- \(from):\n\(_promote.summary)",
			][0]
		}
	}
}
