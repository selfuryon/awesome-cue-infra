{ inputs, ... }:
{
  imports = [ inputs.treefmt-nix.flakeModule ];

  perSystem =
    { config, ... }:
    {
      treefmt = {
        projectRootFile = ".git/config";
        programs = {
          nixfmt.enable = true;
          prettier.enable = true;
          cue.enable = true;
        };
        settings.global.excludes = [
          "cue.mod/*"
          "flake.lock"
          # Generated by `cue cmd write-release`; must stay byte-identical.
          "clusters/*/release/*"
        ];
      };
      formatter = config.treefmt.build.wrapper;
    };
}
