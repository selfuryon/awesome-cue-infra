{ inputs, ... }:
{
  imports = [
    inputs.pre-commit-hooks-nix.flakeModule
  ];

  perSystem = {
    pre-commit.settings = {
      excludes = [
        "cue.mod/"
        "flake.lock"
        # Generated by `cue cmd write-release`; must stay byte-identical.
        "clusters/[^/]*/release/"
      ];
      hooks = {
        cue-fmt.enable = true;
        nixfmt.enable = true;
        prettier.enable = true;
        statix.enable = true;
        deadnix.enable = true;
        zizmor.enable = true;
      };
    };
  };
}
